# AutoApply AI — Environment Configuration Template
# Copy this file to .env and configure for your environment.

# Environment Mode: 'development' or 'production'
# In production, startup will fail loudly if placeholder secrets are detected.
ENV=development

# Application encryption secret (used by LocalEncryptedSecretsManager)
# Must be set to a high-entropy string in production.
SECRET_KEY=autoapply-dev-secret-key-change-in-production-min32chars!

# JWT token signing secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=autoapply-jwt-secret-key-change-in-production-min32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Minimum cosine-similarity match score (0.0 to 1.0) for recommendation
MATCH_THRESHOLD=0.35

# Safety Valve Defaults (NON-NEGOTIABLE: Never set AUTO_SUBMIT_ENABLED=true globally)
DRY_RUN=true
AUTO_SUBMIT_ENABLED=false

# Optional LLM integration (Anthropic Claude for tailored cover letter generation & field mapping)
# If omitted or empty, deterministic rule-based heuristics will be used automatically.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Database Configuration (Defaults to SQLite WAL mode)
# For production PostgreSQL: postgresql://postgres:password@postgres:5432/autoapply
# DATABASE_URL=sqlite:///./app/data/autoapply.db

# Optional Transactional Email Provider (for password resets)
# In development, tokens are logged directly to the server terminal.
# MAIL_PROVIDER=console
# MAIL_API_KEY=
